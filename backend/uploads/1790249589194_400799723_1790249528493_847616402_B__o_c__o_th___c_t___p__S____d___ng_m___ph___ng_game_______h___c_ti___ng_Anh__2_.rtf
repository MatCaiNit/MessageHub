}
\par\pard\plain
{\slmult0\ltrpar\li600
Framework game m\u227\'3f ngu\u7891\'3fn m\u7903\'3f HTML5 \u273\'3f\u7875\'3f t\u7841\'3fo game tr\u234\'3fn tr\u236\'3fnh duy\u7879\'3ft.
\par\pard\plain}
\slmult0\ltrpar\li400
{\fs20
